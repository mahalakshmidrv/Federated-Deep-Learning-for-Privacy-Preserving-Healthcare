# ============================================================
# 4. PREPARE HOSPITAL DATA
# ============================================================

def prepare_hospital_data(
    hospital_data
):

    features = [
        "age",
        "blood_pressure",
        "glucose",
        "cholesterol",
        "bmi",
        "heart_rate",
        "smoking",
        "physical_activity",
        "family_history"
    ]

    X = hospital_data[
        features
    ]

    y = hospital_data[
        "disease"
    ]

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=RANDOM_STATE,
        stratify=y
    )

    scaler = StandardScaler()

    X_train = scaler.fit_transform(
        X_train
    )

    X_test = scaler.transform(
        X_test
    )

    return (
        X_train,
        X_test,
        y_train,
        y_test,
        scaler
    )


# ============================================================
# 5. CREATE LOCAL MODEL
# ============================================================

def create_model():

    model = MLPClassifier(

        hidden_layer_sizes=(
            32,
            16
        ),

        activation="relu",

        solver="adam",

        learning_rate_init=0.001,

        max_iter=100,

        random_state=RANDOM_STATE
    )

    return model


# ============================================================
# 6. GET MODEL PARAMETERS
# ============================================================

def get_model_parameters(
    model
):

    parameters = []

    for weight in model.coefs_:

        parameters.append(
            weight.copy()
        )

    for bias in model.intercepts_:

        parameters.append(
            bias.copy()
        )

    return parameters


# ============================================================
# 7. SET MODEL PARAMETERS
# ============================================================

def set_model_parameters(
    model,
    parameters
):

    number_of_weights = len(
        model.coefs_
    )

    for i in range(
        number_of_weights
    ):

        model.coefs_[i] = (
            parameters[i].copy()
        )

    for i in range(
        len(model.intercepts_)
    ):

        model.intercepts_[i] = (
            parameters[
                number_of_weights + i
            ].copy()
        )


# ============================================================
# 8. INITIALIZE GLOBAL MODEL
# ============================================================

def initialize_global_model(
    input_size
):

    model = create_model()

    # --------------------------------------------------------
    # Initialize model by fitting a tiny dummy dataset
    # --------------------------------------------------------

    dummy_X = np.zeros(
        (2, input_size)
    )

    dummy_y = np.array(
        [0, 1]
    )

    model.fit(
        dummy_X,
        dummy_y
    )

    return model


# ============================================================
# 9. FEDERATED AVERAGING
# ============================================================

def federated_average(
    local_parameters,
    data_sizes
):

    total_samples = sum(
        data_sizes
    )

    global_parameters = []

    for parameter_index in range(
        len(local_parameters[0])
    ):

        weighted_sum = np.zeros_like(
            local_parameters[0][
                parameter_index
            ]
        )

        for client_index in range(
            len(local_parameters)
        ):

            weight = (
                data_sizes[client_index]
                /
                total_samples
            )

            weighted_sum += (
                weight
                *
                local_parameters[
                    client_index
                ][parameter_index]
            )

        global_parameters.append(
            weighted_sum
        )

    return global_parameters


# ============================================================
# 10. FEDERATED TRAINING
# ============================================================

def federated_training(
    hospitals
):

    print("\n")
    print("=" * 65)
    print("FEDERATED LEARNING TRAINING")
    print("=" * 65)

    prepared_data = []

    for hospital in hospitals:

        prepared_data.append(
            prepare_hospital_data(
                hospital
            )
        )

    global_model = initialize_global_model(
        input_size=9
    )

    global_parameters = (
        get_model_parameters(
            global_model
        )
    )

    accuracy_history = []

    for round_number in range(
        1,
        FEDERATED_ROUNDS + 1
    ):

        print(
            f"\nFederated Round "
            f"{round_number}/{FEDERATED_ROUNDS}"
        )

        local_parameters = []

        data_sizes = []

        # ----------------------------------------------------
        # Each hospital trains locally
        # ----------------------------------------------------

        for hospital_index in range(
            NUM_HOSPITALS
        ):

            (
                X_train,
                X_test,
                y_train,
                y_test,
                scaler
            ) = prepared_data[
                hospital_index
            ]

            local_model = create_model()

            local_model.fit(
                X_train,
                y_train
            )

            # ------------------------------------------------
            # IMPORTANT:
            # Only model parameters are shared.
            # Patient data remains local.
            # ------------------------------------------------

            parameters = (
                get_model_parameters(
                    local_model
                )
            )

            local_parameters.append(
                parameters
            )

            data_sizes.append(
                len(X_train)
            )

            print(
                f"  Hospital "
                f"{hospital_index + 1}: "
                f"Local training complete"
            )

        # ----------------------------------------------------
        # Server performs FedAvg
        # ----------------------------------------------------

        global_parameters = federated_average(
            local_parameters,
            data_sizes
        )

        set_model_parameters(
            global_model,
            global_parameters
        )

        # ----------------------------------------------------
        # Evaluate global model
        # ----------------------------------------------------

        round_accuracy = evaluate_global_model(
            global_model,
            prepared_data
        )

        accuracy_history.append(
            round_accuracy
        )

        print(
            f"  Global Model Accuracy: "
            f"{round_accuracy * 100:.2f}%"
        )

    return (
        global_model,
        prepared_data,
        accuracy_history
    )


# ============================================================
# 11. GLOBAL MODEL EVALUATION
# ============================================================

def evaluate_global_model(
    model,
    prepared_data
):

    all_predictions = []

    all_actual = []

    for (
        X_train,
        X_test,
        y_train,
        y_test,
        scaler
    ) in prepared_data:

        predictions = model.predict(
            X_test
        )

        all_predictions.extend(
            predictions
        )

        all_actual.extend(
            y_test
        )

    accuracy = accuracy_score(
        all_actual,
        all_predictions
    )

    return accuracy


# ============================================================
# 12. FINAL EVALUATION
# ============================================================

def final_evaluation(
    model,
    prepared_data
):

    all_predictions = []

    all_actual = []

    for (
        X_train,
        X_test,
        y_train,
        y_test,
        scaler
    ) in prepared_data:

        predictions = model.predict(
            X_test
        )

        all_predictions.extend(
            predictions
        )

        all_actual.extend(
            y_test
        )

    accuracy = accuracy_score(
        all_actual,
        all_predictions
    )

    precision = precision_score(
        all_actual,
        all_predictions
    )

    recall = recall_score(
        all_actual,
        all_predictions
    )

    f1 = f1_score(
        all_actual,
        all_predictions
    )

    cm = confusion_matrix(
        all_actual,
        all_predictions
    )

    print("\n")
    print("=" * 65)
    print("FINAL FEDERATED MODEL EVALUATION")
    print("=" * 65)

    print(
        f"\nAccuracy  : {accuracy * 100:.2f}%"
    )

    print(
        f"Precision : {precision * 100:.2f}%"
    )

    print(
        f"Recall    : {recall * 100:.2f}%"
    )

    print(
        f"F1 Score  : {f1 * 100:.2f}%"
    )

    print(
        "\nClassification Report:"
    )

    print(
        classification_report(
            all_actual,
            all_predictions,
            target_names=[
                "No Disease",
                "Disease"
            ]
        )
    )

    print(
        "Confusion Matrix:"
    )

    print(cm)

    return (
        accuracy,
        precision,
        recall,
        f1,
        cm
    )


# ============================================================
# 13. CONFUSION MATRIX GRAPH
# ============================================================

def plot_confusion_matrix(
    cm
):

    plt.figure(
        figsize=(6, 5)
    )

    plt.imshow(
        cm,
        interpolation="nearest"
    )

    plt.title(
        "Federated Healthcare Model"
        "\nConfusion Matrix"
    )

    plt.colorbar()

    plt.xticks(
        [0, 1],
        [
            "No Disease",
            "Disease"
        ]
    )

    plt.yticks(
        [0, 1],
        [
            "No Disease",
            "Disease"
        ]
    )

    plt.xlabel(
        "Predicted"
    )

    plt.ylabel(
        "Actual"
    )

    for i in range(2):

        for j in range(2):

            plt.text(
                j,
                i,
                cm[i, j],
                ha="center",
                va="center"
            )

    plt.tight_layout()

    plt.show()


# ============================================================
# 14. FEDERATED TRAINING GRAPH
# ============================================================

def plot_training_history(
    history
):

    rounds = range(
        1,
        len(history) + 1
    )

    plt.figure(
        figsize=(8, 5)
    )

    plt.plot(
        rounds,
        np.array(history) * 100,
        marker="o"
    )

    plt.title(
        "Federated Learning Accuracy"
    )

    plt.xlabel(
        "Federated Round"
    )

    plt.ylabel(
        "Accuracy (%)"
    )

    plt.grid(
        True
    )

    plt.tight_layout()

    plt.show()


