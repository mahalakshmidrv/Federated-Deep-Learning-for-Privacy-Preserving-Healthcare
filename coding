# ============================================================
# FEDERATED DEEP LEARNING FOR PRIVACY-PRESERVING HEALTHCARE
# Educational Offline Prototype
# ============================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neural_network import MLPClassifier

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)


# ============================================================
# CONFIGURATION
# ============================================================

NUM_HOSPITALS = 5
SAMPLES_PER_HOSPITAL = 400
FEDERATED_ROUNDS = 10

RANDOM_STATE = 42

np.random.seed(RANDOM_STATE)


# ============================================================
# 1. GENERATE SYNTHETIC HEALTHCARE DATA
# ============================================================

def generate_healthcare_data(
    samples,
    hospital_id
):

    age = np.random.randint(
        20,
        85,
        samples
    )

    blood_pressure = np.random.normal(
        125,
        20,
        samples
    )

    glucose = np.random.normal(
        110,
        35,
        samples
    )

    cholesterol = np.random.normal(
        190,
        40,
        samples
    )

    bmi = np.random.normal(
        26,
        5,
        samples
    )

    heart_rate = np.random.normal(
        75,
        12,
        samples
    )

    smoking = np.random.binomial(
        1,
        0.25,
        samples
    )

    physical_activity = np.random.uniform(
        0,
        10,
        samples
    )

    family_history = np.random.binomial(
        1,
        0.30,
        samples
    )

    # --------------------------------------------------------
    # Disease Risk Score
    # --------------------------------------------------------

    risk_score = (

        0.025 * (age - 40)

        + 0.020 * (blood_pressure - 120)

        + 0.018 * (glucose - 100)

        + 0.012 * (cholesterol - 180)

        + 0.040 * (bmi - 25)

        + 0.015 * (heart_rate - 70)

        + 0.80 * smoking

        - 0.15 * physical_activity

        + 0.70 * family_history

        + np.random.normal(
            0,
            1,
            samples
        )
    )

    probability = (
        1 /
        (
            1 +
            np.exp(-risk_score / 5)
        )
    )

    disease = (
        probability > 0.5
    ).astype(int)

    data = pd.DataFrame({

        "age": age,

        "blood_pressure": blood_pressure,

        "glucose": glucose,

        "cholesterol": cholesterol,

        "bmi": bmi,

        "heart_rate": heart_rate,

        "smoking": smoking,

        "physical_activity": physical_activity,

        "family_history": family_history,

        "disease": disease

    })

    data["hospital"] = hospital_id

    return data


# ============================================================
# 2. CREATE HOSPITAL DATA
# ============================================================

def create_hospital_data():

    hospitals = []

    print("\nGenerating synthetic healthcare data...")

    for hospital_id in range(
        1,
        NUM_HOSPITALS + 1
    ):

        data = generate_healthcare_data(
            SAMPLES_PER_HOSPITAL,
            hospital_id
        )

        hospitals.append(
            data
        )

    print(
        f"{NUM_HOSPITALS} hospitals created."
    )

    return hospitals


# ============================================================
# 3. DISPLAY DATA
# ============================================================

def display_data(hospitals):

    print("\n")
    print("=" * 65)
    print("HEALTHCARE DATA INFORMATION")
    print("=" * 65)

    for i, data in enumerate(
